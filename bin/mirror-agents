#!/usr/bin/env python3
"""Mirror one shard of agents.yaml: one GitHub release per agent.

Each agent gets its own release, tagged with its id, holding two assets -- the
character file and a thumbnail rendered from its first frame. Two assets per
release sidesteps GitHub's cap of 1000 assets per release, which a release per
source directory cannot (`char` alone holds over 13,000 characters).

Names come from agents.yaml and nothing here is derived: `name` is upstream's
filename, `file` the published character file, `image` the thumbnail, `id` the
release tag. The only values this stage produces are each file's sha256, which
must be measured, and the thumbnail, which must be decoded.

Optionally also pushes to ghcr.io, where ORAS records the exact upstream
filename in the layer annotation -- punctuation and all -- which a release
asset name cannot carry.

  mirror-agents --shard 0 --shards 40
  mirror-agents --shard 0 --shards 40 --skip-ghcr --limit 20 --dry-run
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import yaml  # noqa: E402

from acs import AcsError, first_frame, thumbnail, to_rgba, write_png  # noqa: E402

UA = "ms-agents.nix/1.0 (+https://github.com/n-at-han-k/ms-agents.nix)"

# tmafe.com answers a missing file with this fixed page under HTTP 200, and its
# own indexes do list files that return it.
SOFT404_SHA256 = "52b81c40b14d13fe09b4298ea6773a4ada82b3f49b81c96e8c988b77527731bb"

PRIMARY_HOST = "https://tmafe.com"
MIRROR_HOST = "https://tmafemirror.org"

# Mirrored ahead of everything else.
PRIORITY_DIRS = ("classic-ms-agents",)


def log(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def run(cmd: list, cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, cwd=cwd)


class RateLimited(Exception):
    """GitHub refused the write because the hourly budget is spent."""


def gh(*args: str) -> subprocess.CompletedProcess:
    p = run(["gh", *args])
    if p.returncode != 0 and "rate limit" in (p.stderr or "").lower():
        raise RateLimited((p.stderr or "").strip()[:160])
    return p


def existing_tags(repo: str) -> set:
    """Every release tag already published, fetched once.

    Asking per agent costs one request each, so as the mirror fills up most of
    the hourly budget goes on discovering work that is already done. One
    paginated sweep is ~1 request per 100 releases instead, which leaves the
    budget for actual writes.
    """
    p = run(["gh", "api", "--paginate", f"/repos/{repo}/releases",
             "--jq", ".[].tag_name"])
    if p.returncode != 0:
        log(f"  could not list releases ({(p.stderr or '').strip()[:100]}); "
            f"falling back to per-agent checks")
        return set()
    return {ln.strip() for ln in p.stdout.splitlines() if ln.strip()}


def fallback_urls(url: str) -> list:
    if url.startswith(PRIMARY_HOST):
        return [url, MIRROR_HOST + url[len(PRIMARY_HOST):]]
    if url.startswith(MIRROR_HOST):
        return [url, PRIMARY_HOST + url[len(MIRROR_HOST):]]
    return [url]


def download(url: str, dest: Path, retries: int = 3):
    """Stream to dest, hashing as it goes. None if every host/attempt failed."""
    for candidate in fallback_urls(url):
        for attempt in range(1, retries + 1):
            digest, size = hashlib.sha256(), 0
            req = urllib.request.Request(candidate, headers={"User-Agent": UA})
            try:
                with urllib.request.urlopen(req, timeout=300) as r, dest.open("wb") as f:
                    while chunk := r.read(1 << 20):
                        digest.update(chunk)
                        size += len(chunk)
                        f.write(chunk)
            except (urllib.error.URLError, OSError, EOFError) as e:
                if attempt == retries:
                    log(f"      ! {candidate}: {e}")
                else:
                    time.sleep(2 * attempt)
                continue
            return digest.hexdigest(), size
    return None


def why_invalid(path: Path, sha: str, size: int, filename: str):
    if sha == SOFT404_SHA256:
        return "soft-404 page"
    if size == 0:
        return "empty"
    return None


def existing_assets(tag: str):
    """Asset names already on the release; None if the release doesn't exist."""
    p = gh("release", "view", tag, "--json", "assets")
    if p.returncode != 0:
        return None
    try:
        return {a["name"] for a in json.loads(p.stdout).get("assets") or []}
    except (json.JSONDecodeError, KeyError):
        return set()


def ghcr_push(ref: str, path: Path, filename: str):
    """ORAS reads the layer title from the path as given, so it must be a bare
    basename resolved against the file's own directory."""
    p = run([
        "oras", "push", ref,
        "--annotation", f"org.opencontainers.image.title={filename}",
        "--annotation", "org.opencontainers.image.source="
                        "https://github.com/n-at-han-k/ms-agents.nix",
        f"{path.name}:application/vnd.microsoft.agent.character",
    ], cwd=path.parent)
    return p.returncode == 0, (p.stderr or p.stdout).strip()[:160]


def shard_of(agent: dict, shards: int) -> int:
    """Stable shard keyed on the id, so a re-harvest in a different order still
    sends each agent to the same shard and a re-run resumes."""
    return int.from_bytes(
        hashlib.sha256(agent["id"].encode()).digest()[:8], "big") % shards


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--manifest", type=Path, default=Path("agents.yaml"))
    ap.add_argument("--shard", type=int, default=0)
    ap.add_argument("--shards", type=int, default=1)
    ap.add_argument("--out", type=Path, default=Path("partial.json"))
    ap.add_argument("--repo", default=os.environ.get(
        "GITHUB_REPOSITORY", "n-at-han-k/ms-agents.nix"))
    ap.add_argument("--registry", help="default ghcr.io/<owner>/ms-agents")
    ap.add_argument("--box", type=int, default=96, help="thumbnail longest side")
    ap.add_argument("--skip-ghcr", action="store_true")
    ap.add_argument("--only", help="restrict to one source directory")
    ap.add_argument("--limit", type=int)
    ap.add_argument("--budget", type=int,
                    help="stop after publishing this many, to stay inside the "
                         "hourly API allowance")
    ap.add_argument("--dry-run", action="store_true",
                    help="download, validate and render, but publish nothing")
    args = ap.parse_args()

    owner = args.repo.split("/")[0].lower()
    registry = args.registry or f"ghcr.io/{owner}/ms-agents"
    if not args.skip_ghcr and not shutil.which("oras"):
        log("oras not on PATH; continuing with releases only")
        args.skip_ghcr = True

    agents = yaml.safe_load(args.manifest.read_text())["agents"]
    shard = [a for a in agents if shard_of(a, args.shards) == args.shard]
    if args.only:
        shard = [a for a in shard if a["dir"] == args.only]
    # The original Microsoft-shipped characters are the ones anyone actually
    # comes looking for, and a budgeted run only gets through a slice, so they
    # go first rather than waiting behind thousands of fan uploads.
    shard.sort(key=lambda a: (0 if a["dir"] in PRIORITY_DIRS else 1,
                              a["dir"], a["name"].lower()))
    if args.limit:
        shard = shard[: args.limit]

    log(f"shard {args.shard}/{args.shards}: {len(shard)} of {len(agents)} agents")
    log(f"  one release per agent; ghcr: {'skipped' if args.skip_ghcr else registry}")

    skip_ghcr = args.skip_ghcr
    budget = args.budget
    published = existing_tags(args.repo)
    log(f"  {len(published)} releases already published")

    out: dict = {}
    stats: Counter = Counter()

    with tempfile.TemporaryDirectory() as tmp:
      tmpdir = Path(tmp)
      try:
        for i, a in enumerate(shard, 1):
            tag = a["id"]

            row = {
                "name": a["name"], "file": a["file"], "image": a["image"],
                "dir": a["dir"], "release": tag,
                "url": f"https://github.com/{args.repo}/releases/download/{tag}/{a['file']}",
                "image_url": f"https://github.com/{args.repo}/releases/download/{tag}/{a['image']}",
                "upstream": a["url"],
            }

            # Already published -- costs nothing to establish, so a resumed
            # run spends its budget only on what is actually missing.
            if tag in published:
                stats["skipped"] += 1
                continue

            if budget is not None and stats["published"] >= budget:
                log(f"  budget of {budget} reached; stopping cleanly")
                break

            # ORAS needs the upstream filename verbatim; the release needs the
            # published one. Download under the upstream name, rename after.
            exact = tmpdir / a["name"]
            got = download(a["url"], exact)
            if got is None:
                stats["download_failed"] += 1
                continue
            sha, size = got
            if reason := why_invalid(exact, sha, size, a["name"]):
                log(f"  [{i}/{len(shard)}] {tag}: {reason}")
                stats["invalid"] += 1
                exact.unlink(missing_ok=True)
                continue
            row["sha256"] = sha
            row["size"] = size

            try:
                if not skip_ghcr and not args.dry_run:
                    ok, err = ghcr_push(f"{registry}/{a['dir']}:{tag}", exact, a["name"])
                    stats["ghcr_pushed" if ok else "ghcr_failed"] += 1
                    if ok:
                        row["ghcr"] = f"{registry}/{a['dir']}:{tag}"
                    else:
                        # A missing write:packages scope fails identically for
                        # every agent, so report it once and stop trying rather
                        # than logging it 39,599 times.
                        if "permission_denied" in err or "denied" in err:
                            log(f"  ghcr disabled for this run: {err}")
                            skip_ghcr = True
                        else:
                            log(f"  [{i}/{len(shard)}] {tag}: ghcr: {err}")

                # Thumbnail. A good share of the archive is mislabelled or an
                # older container, so a failure here is expected and only
                # costs the image, never the character file.
                png = tmpdir / a["image"]
                try:
                    frame = first_frame(exact.read_bytes())
                    rgba, w, h = thumbnail(
                        to_rgba(frame), frame.width, frame.height, args.box)
                    write_png(png, rgba, w, h)
                    row["thumbnail"] = True
                    stats["rendered"] += 1
                except (AcsError, Exception) as e:  # noqa: BLE001
                    row["thumbnail"] = False
                    row["render_error"] = str(e)[:120]
                    stats["unrenderable"] += 1

                named = tmpdir / a["file"]
                exact.replace(named)

                if args.dry_run:
                    stats["would_publish"] += 1
                else:
                    if True:
                        c = gh("release", "create", tag,
                               "--title", a["name"],
                               "--notes",
                               f"`{a['name']}` from "
                               f"[/{a['dir']}/](https://tmafe.com/{a['dir']}/), "
                               f"mirrored from tmafe.com.\n\n"
                               f"```\nnix build github:{args.repo}#{tag}\n```")
                        if c.returncode != 0 and "already exists" not in (c.stderr or ""):
                            log(f"  [{i}/{len(shard)}] {tag}: create: "
                                f"{c.stderr.strip()[:140]}")
                            stats["failed"] += 1
                            continue
                    uploads = [named] + ([png] if row.get("thumbnail") else [])
                    u = gh("release", "upload", tag, *[str(x) for x in uploads],
                           "--clobber")
                    if u.returncode != 0:
                        log(f"  [{i}/{len(shard)}] {tag}: upload: "
                            f"{u.stderr.strip()[:140]}")
                        stats["failed"] += 1
                        continue
                    stats["published"] += 1
                    published.add(tag)

                out[a["id"]] = row
            finally:
                for f in tmpdir.iterdir():
                    f.unlink(missing_ok=True)

            if i % 25 == 0 or i == len(shard):
                log(f"  [{i}/{len(shard)}] " +
                    "  ".join(f"{k}={v}" for k, v in sorted(stats.items())))
      except RateLimited as e:
        # Every further write would fail the same way, and a failed write still
        # costs a request. Stop and let the next scheduled run resume.
        log(f"\n  rate limited, stopping: {e}")
        stats["rate_limited"] = 1

    args.out.write_text(json.dumps(out, indent=2, sort_keys=True) + "\n")
    log(f"\nwrote {args.out}: {len(out)} agents  "
        + "  ".join(f"{k}={v}" for k, v in sorted(stats.items())))
    return 1 if shard and not out else 0


if __name__ == "__main__":
    sys.exit(main())
