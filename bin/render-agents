#!/usr/bin/env python3
"""Render one shard of agents.yaml to thumbnails under images/<dir>/<name>.png.

The tree mirrors the character files themselves, so images/char/Foo-ab12cd34.png
sits alongside the release asset char/Foo-ab12cd34.acs.

Prefers our own mirrored release asset over upstream: the mirror has already
pulled 52 GB off a hobby server once, and there is no reason to do it twice.
Falls back to upstream for anything not mirrored yet.

Not every file decodes. A meaningful share of the archive is mislabelled --
text files and other formats carrying an .acs extension -- and .acd/.acf are
definition files with no image table. Those are reported and skipped, never
guessed at.

  render-agents --shard 0 --shards 20
  render-agents --only classic-ms-agents --limit 50
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
import urllib.error
import urllib.request
from collections import Counter
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

import yaml  # noqa: E402

from acs import AcsError, first_frame, thumbnail, to_rgba, write_png  # noqa: E402

UA = "ms-agents.nix/1.0 (+https://github.com/n-at-han-k/ms-agents.nix)"
SOFT404_SHA256 = "52b81c40b14d13fe09b4298ea6773a4ada82b3f49b81c96e8c988b77527731bb"


def log(msg: str) -> None:
    print(msg, file=sys.stderr, flush=True)


def fetch(url: str, retries: int = 3) -> bytes | None:
    for attempt in range(1, retries + 1):
        try:
            req = urllib.request.Request(url, headers={"User-Agent": UA})
            with urllib.request.urlopen(req, timeout=180) as r:
                body = r.read()
            if hashlib.sha256(body).hexdigest() == SOFT404_SHA256:
                return None
            return body
        except (urllib.error.URLError, OSError, EOFError):
            if attempt == retries:
                return None
    return None


def shard_of(agent: dict, shards: int) -> int:
    return int.from_bytes(
        hashlib.sha256(agent["id"].encode()).digest()[:8], "big") % shards


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--manifest", type=Path, default=Path("agents.yaml"))
    ap.add_argument("--mirrored", type=Path, default=Path("agents.json"),
                    help="mirror manifest, for release-asset URLs")
    ap.add_argument("--out", type=Path, default=Path("images"))
    ap.add_argument("--report", type=Path, default=Path("render-report.json"))
    ap.add_argument("--box", type=int, default=96, help="longest side, px")
    ap.add_argument("--shard", type=int, default=0)
    ap.add_argument("--shards", type=int, default=1)
    ap.add_argument("--only", help="restrict to one source directory")
    ap.add_argument("--limit", type=int)
    ap.add_argument("--force", action="store_true",
                    help="re-render thumbnails that already exist")
    args = ap.parse_args()

    agents = yaml.safe_load(args.manifest.read_text())["agents"]
    mirrored = {}
    if args.mirrored.exists():
        mirrored = json.loads(args.mirrored.read_text())
        log(f"mirror manifest: {len(mirrored)} agents with release assets")

    work = [a for a in agents if shard_of(a, args.shards) == args.shard]
    if args.only:
        work = [a for a in work if a["dir"] == args.only]
    if args.limit:
        work = work[: args.limit]

    log(f"shard {args.shard}/{args.shards}: {len(work)} agents -> {args.out}/")

    stats: Counter = Counter()
    failures: dict[str, str] = {}

    for i, a in enumerate(work, 1):
        dest = args.out / a["dir"] / (a["file"].rsplit(".", 1)[0] + ".png")
        if dest.exists() and not args.force:
            stats["skipped"] += 1
            continue

        # Our mirror first, upstream only as a fallback.
        row = mirrored.get(a["id"])
        urls = [u for u in ((row or {}).get("url"), a["url"]) if u]
        data = None
        for u in urls:
            data = fetch(u)
            if data:
                break
        if not data:
            stats["download_failed"] += 1
            failures[a["id"]] = "download failed"
            continue

        try:
            frame = first_frame(data)
            rgba, w, h = thumbnail(to_rgba(frame), frame.width, frame.height, args.box)
            dest.parent.mkdir(parents=True, exist_ok=True)
            write_png(dest, rgba, w, h)
            stats["rendered"] += 1
        except AcsError as e:
            # Expected for the mislabelled and non-image files in the archive.
            stats["undecodable"] += 1
            failures[a["id"]] = str(e)[:120]
        except Exception as e:  # noqa: BLE001
            stats["error"] += 1
            failures[a["id"]] = f"{type(e).__name__}: {str(e)[:100]}"

        if i % 100 == 0 or i == len(work):
            log(f"  [{i}/{len(work)}] " +
                "  ".join(f"{k}={v}" for k, v in sorted(stats.items())))

    args.report.write_text(json.dumps(
        {"shard": args.shard, "shards": args.shards,
         "stats": dict(stats), "failures": failures}, indent=2, sort_keys=True) + "\n")
    log(f"\n{args.report}: " + "  ".join(f"{k}={v}" for k, v in sorted(stats.items())))
    return 0 if stats["rendered"] or stats["skipped"] else 1


if __name__ == "__main__":
    sys.exit(main())
